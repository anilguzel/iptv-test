# Shared image for the FastAPI API, signal-engine and notification-worker.
# The service is selected by the command in docker-compose.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps (psycopg build is covered by the binary wheel).
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY infrastructure/docker/requirements.txt /tmp/requirements.txt
RUN pip install --upgrade pip && pip install -r /tmp/requirements.txt

# Install the shared core library.
COPY packages/bist_core /app/packages/bist_core
RUN pip install -e /app/packages/bist_core

# Service code.
COPY services /app/services

# `app.main:app` (api) resolves from services/api; `python -m signal_engine`
# and `python -m notification_worker` resolve from services.
ENV PYTHONPATH=/app/services:/app/services/api

EXPOSE 8000

# Default command (overridden per service in docker-compose).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "/app/services/api"]
