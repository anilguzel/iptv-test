# ---- General -------------------------------------------------------------
ENVIRONMENT=development

# Demo mode: deterministic, clearly-fake data (DataStatus=DEMO). Great for a
# first run with no external provider. Set to false for the real provider.
DEMO_MODE=true

# ---- Market data provider ------------------------------------------------
# "bist" (open-source bist-data-service, ~15 min DELAYED) or "demo".
MARKET_DATA_PROVIDER=bist
BIST_DATA_SERVICE_URL=http://host.docker.internal:8000
PROVIDER_TIMEOUT=10
# Only if the service runs with API_KEYS set (sent as X-API-Key).
BIST_DATA_SERVICE_API_KEY=
# Quotes older than this many seconds (vs market timestamp) are STALE.
STALE_AFTER_SECONDS=180

# ---- Ingestion -----------------------------------------------------------
POLL_INTERVAL_SECONDS=60
SIGNAL_INTERVAL_SECONDS=60

# ---- Storage -------------------------------------------------------------
POSTGRES_USER=bist
POSTGRES_PASSWORD=bist
POSTGRES_DB=bist
DATABASE_URL=postgresql+psycopg://bist:bist@postgres:5432/bist
REDIS_URL=redis://redis:6379/0

# ---- Macro data (TCMB EVDS) ----------------------------------------------
# Macro CONTEXT only (FX / rates / CPI) — EVDS never provides equity prices.
# "demo" (offline, deterministic), "evds" (TCMB EVDS REST API), or "none".
# In DEMO_MODE this is forced to "demo".
MACRO_PROVIDER=demo
# Free API key from the EVDS profile page (evds3.tcmb.gov.tr -> Benim Sayfam
# -> Profilim -> API KEY KOPYALA). Required only when MACRO_PROVIDER=evds.
EVDS_API_KEY=
EVDS_BASE_URL=https://evds2.tcmb.gov.tr/service/evds
# Series codes to track (comma list). Defaults: USD/TRY and EUR/TRY buying rates.
MACRO_SERIES=TP.DK.USD.A,TP.DK.EUR.A

# ---- Research (weekly walk-forward) --------------------------------------
# Written by `python -m bist_core.research`, served by GET /research.
RESEARCH_REPORT_PATH=reports/research_latest.json

# ---- AI analyzer ---------------------------------------------------------
# "mock" (offline, deterministic) or "anthropic".
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Telegram ------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SECONDS=600
REVERSAL_COOLDOWN_SECONDS=0
ALERT_MIN_SCORE_DELTA=10

# ---- Watchlist -----------------------------------------------------------
DEFAULT_WATCHLIST=KTLEV,THYAO,ASELS,TUPRS,EREGL
